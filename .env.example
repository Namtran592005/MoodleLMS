# DB
# dung ba mat khau khac nhau
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# App
TZ=Asia/Ho_Chi_Minh
APP_ENV=production

# Giu ten image on dinh khi backup/restore offline
COMPOSE_PROJECT_NAME=moodle-server

# UID/GID theo owner moodle/
# PUID=1000
# PGID=1000

# Apache event MPM + PHP-FPM; de trong = tu tinh theo CPU/RAM
# APACHE_MAX_REQUEST_WORKERS=40
# APACHE_START_SERVERS=2
# PHP_FPM_MAX_CHILDREN=24
# MOODLE_WORKER_MEM_MB=64
# MOODLE_MEM_RESERVE_MB=
