MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MOODLE_DB_HOST=db
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Mat khau ma hoa kho restic. Ky tu # chi la chu khi khong co dau cach dung truoc;
# doi mat khau thi phai chay `restic key passwd` hoac tao lai kho (xem NOTES).
RESTIC_PASSWORD=CHANGE_THIS_RESTIC_PASSWORD
RESTIC_REPOSITORY=/backup/restic

TZ=Asia/Ho_Chi_Minh
APP_ENV=production
MOODLE_WWWROOT=http://localhost
MOODLE_SSLPROXY=false

COMPOSE_PROJECT_NAME=moodle-server

PUID=1000
PGID=1000

APACHE_MAX_REQUEST_WORKERS=
APACHE_START_SERVERS=
PHP_FPM_MAX_CHILDREN=24
MOODLE_WORKER_MEM_MB=64
MOODLE_MEM_RESERVE_MB=
