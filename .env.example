# DB (MySQL 9 LTS)
# Dung ba mat khau khac nhau, khong dung chung mot chuoi.
# Chi dung chu, so va cac ky tu an toan; tranh # va $ de khong bi cat
# khi doc tu .env hoac truyen qua shell.
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Cache
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# App
TZ=Asia/Ho_Chi_Minh
APP_ENV=production

# Quyen: TU DONG lay theo owner cua moodle/ (hoac moodledata/), thuong
# chinh la tai khoan Linux mac dinh (uid 1000). Khong can khai bao gi.
# Chi bo comment 2 dong duoi neu muon ep buoc UID/GID khac:
# PUID=1000
# PGID=1000
